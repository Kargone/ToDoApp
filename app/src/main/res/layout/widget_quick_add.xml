<?xml version="1.0" encoding="utf-8"?>
<!-- Quick-add widget. The whole card is one click target that launches QuickAddActivity. Content is
     centered so it reads well at any size the user resizes to; the label truncates before the icon. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@drawable/widget_bg"
    android:padding="10dp">

    <ImageView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_circle_accent"
        android:padding="7dp"
        android:src="@drawable/ic_plus"
        android:contentDescription="@string/widget_quick_add_label" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:text="@string/widget_quick_add_label"
        android:textColor="@color/fg"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
