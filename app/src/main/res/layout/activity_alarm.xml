<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen ringing alarm. Graphite, centered; big task title, Dismiss + Snooze. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bg"
    android:padding="32dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:src="@drawable/ic_alarm"
        android:tint="@color/accent"
        android:contentDescription="@null" />

    <TextView
        android:id="@+id/alarm_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="monospace"
        android:textColor="@color/muted"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/alarm_task"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/fg"
        android:textSize="26sp"
        android:textStyle="bold" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/alarm_dismiss"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_btn_filled"
        android:text="@string/alarm_dismiss"
        android:textAllCaps="false"
        android:textColor="@color/on_accent"
        android:textSize="16sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/alarm_snooze"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_outline"
        android:text="@string/alarm_snooze"
        android:textAllCaps="false"
        android:textColor="@color/fg"
        android:textSize="16sp" />
</LinearLayout>
