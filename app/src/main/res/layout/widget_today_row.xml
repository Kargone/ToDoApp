<?xml version="1.0" encoding="utf-8"?>
<!-- One task row in the Today widget. The whole row is the toggle target (fillInIntent carries the
     task id). The check image switches between the unchecked ring and the done circle. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="44dp"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <ImageView
        android:id="@+id/widget_row_check"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/chk_unchecked"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/widget_row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:textColor="@color/fg"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/widget_row_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="monospace"
        android:gravity="end"
        android:textColor="@color/muted"
        android:textSize="11sp" />
</LinearLayout>
