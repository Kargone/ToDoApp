<?xml version="1.0" encoding="utf-8"?>
<!-- Repeat controls, shared by the add sheet and the repeat editor. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Every N  +  unit -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView style="@style/FieldLabel" android:text="@string/repeat_every" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/repeat_interval"
                    android:layout_width="64dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center"
                    android:inputType="number"
                    android:text="1"
                    android:textColor="@color/fg"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/repeat_unit"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/repeat_time_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView style="@style/FieldLabel" android:text="@string/reveal_time" />

            <TextView android:id="@+id/repeat_time" style="@style/FieldValue" />
        </LinearLayout>
    </LinearLayout>

    <!-- Weekly: days of week -->
    <LinearLayout
        android:id="@+id/repeat_weekday_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView style="@style/FieldLabel" android:text="@string/repeat_on" />

        <LinearLayout
            android:id="@+id/weekday_pills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView style="@style/Pill" android:tag="0" android:text="Sun" />
            <TextView style="@style/Pill" android:tag="1" android:text="Mon" />
            <TextView style="@style/Pill" android:tag="2" android:text="Tue" />
            <TextView style="@style/Pill" android:tag="3" android:text="Wed" />
            <TextView style="@style/Pill" android:tag="4" android:text="Thu" />
            <TextView style="@style/Pill" android:tag="5" android:text="Fri" />
            <TextView style="@style/Pill" android:tag="6" android:text="Sat" />
        </LinearLayout>
    </LinearLayout>

    <!-- Monthly: pattern -->
    <LinearLayout
        android:id="@+id/repeat_monthday_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView style="@style/FieldLabel" android:text="@string/monthly_pattern" />

        <Spinner
            android:id="@+id/repeat_month_pattern"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_input"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />
    </LinearLayout>

    <!-- Monthly: days of month -->
    <LinearLayout
        android:id="@+id/repeat_month_days_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView style="@style/FieldLabel" android:text="@string/days_of_month" />

        <EditText
            android:id="@+id/repeat_monthdays"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_input"
            android:hint="@string/days_of_month_hint"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/fg"
            android:textColorHint="@color/muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Monthly weekday: week of month -->
    <LinearLayout
        android:id="@+id/repeat_month_week_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView style="@style/FieldLabel" android:text="@string/week_of_month" />

        <LinearLayout
            android:id="@+id/month_week_pills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView style="@style/Pill" android:tag="1" android:text="1st" />
            <TextView style="@style/Pill" android:tag="2" android:text="2nd" />
            <TextView style="@style/Pill" android:tag="3" android:text="3rd" />
            <TextView style="@style/Pill" android:tag="4" android:text="4th" />
            <TextView style="@style/Pill" android:tag="5" android:text="5th" />
        </LinearLayout>
    </LinearLayout>

    <!-- Monthly weekday: day of week -->
    <LinearLayout
        android:id="@+id/repeat_month_weekday_field"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView style="@style/FieldLabel" android:text="@string/day_of_week" />

        <LinearLayout
            android:id="@+id/month_weekday_pills"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView style="@style/Pill" android:tag="0" android:text="Sun" />
            <TextView style="@style/Pill" android:tag="1" android:text="Mon" />
            <TextView style="@style/Pill" android:tag="2" android:text="Tue" />
            <TextView style="@style/Pill" android:tag="3" android:text="Wed" />
            <TextView style="@style/Pill" android:tag="4" android:text="Thu" />
            <TextView style="@style/Pill" android:tag="5" android:text="Fri" />
            <TextView style="@style/Pill" android:tag="6" android:text="Sat" />
        </LinearLayout>
    </LinearLayout>

    <!-- Stop date -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical">

        <TextView style="@style/FieldLabel" android:text="@string/stop_on" />

        <TextView android:id="@+id/repeat_end" style="@style/FieldValue" />
    </LinearLayout>
</LinearLayout>
