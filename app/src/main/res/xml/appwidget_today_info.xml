<?xml version="1.0" encoding="utf-8"?>
<!-- Today list widget: scrollable, resizable. Collection widgets need updatePeriodMillis=0 and are
     refreshed explicitly (on toggle, and whenever the app re-renders its list). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="60dp"
    android:maxResizeWidth="360dp"
    android:maxResizeHeight="520dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_today_description"
    android:initialLayout="@layout/widget_today"
    android:previewLayout="@layout/widget_today"
    android:updatePeriodMillis="0" />
