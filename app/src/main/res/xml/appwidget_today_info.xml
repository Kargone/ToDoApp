<?xml version="1.0" encoding="utf-8"?>
<!-- Today list widget: scrollable, resizable. Refreshed explicitly on toggle and whenever the app
     re-renders; updatePeriodMillis gives a periodic safety refresh (clamped by the OS to ~30 min)
     so it doesn't drift stale, and ACTION_DATE_CHANGED (manifest) handles the midnight rollover. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="60dp"
    android:maxResizeWidth="360dp"
    android:maxResizeHeight="520dp"
    android:targetCellWidth="3"
    android:targetCellHeight="3"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/widget_today_description"
    android:initialLayout="@layout/widget_today"
    android:previewLayout="@layout/widget_today"
    android:updatePeriodMillis="1800000" />
