# Template for release signing. Copy this file to `keystore.properties` (which is gitignored)
# and fill in the real values. NEVER commit keystore.properties or the .jks keystore itself.
#
# storeFile may be relative to the repo root (e.g. ./todoapp-upload.jks) or an absolute path.
# *.jks is gitignored, so a keystore in the repo root is never committed — but BACK IT UP
# somewhere safe anyway: if you lose the upload key you must contact Google Play support to reset.

storeFile=./todoapp-upload.jks
storePassword=your-keystore-password
keyAlias=upload
keyPassword=your-key-password
