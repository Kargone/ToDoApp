# Template for release signing. Copy this file to `keystore.properties` (which is gitignored)
# and fill in the real values. NEVER commit keystore.properties or the .jks keystore itself.
#
# Keep the keystore OUTSIDE the repo (e.g. your home folder) and point storeFile at it with an
# absolute path, so it can never be accidentally committed. Back it up somewhere safe — if you
# lose the upload key you must contact Google Play support to reset it.

storeFile=C:/Users/karso/keys/todoapp-upload.jks
storePassword=your-keystore-password
keyAlias=upload
keyPassword=your-key-password
